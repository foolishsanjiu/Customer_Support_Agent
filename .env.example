# Copy this file to .env and fill in secrets locally. Never commit .env.
APP_NAME=ResolveX
APP_ENV=development
APP_DEBUG=true
SERVICE_NAME=resolvex-api
LOG_LEVEL=INFO
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

MYSQL_DATABASE=resolvex
MYSQL_USER=resolvex
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

CELERY_BROKER_URL=redis://redis:6379/0
LANGGRAPH_REDIS_URL=redis://redis:6379/0
CONTROL_REDIS_URL=redis://redis:6379/2

LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
MAX_AGENT_STEPS=12
MAX_RECOVERY_ATTEMPTS=3
APPROVAL_TTL_MINUTES=1440
JWT_SECRET=
JWT_ISSUER=resolvex
JWT_AUDIENCE=resolvex-api
CHROMA_PATH=data/chroma
POLICY_DIRECTORY=policies
POLICY_TOP_K=3
CONTEXT_MESSAGE_LIMIT=20
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_CACHE_DIR=D:/CondaEnvs/resolvex/models
BGE_MODEL_CACHE_HOST=D:/CondaEnvs/resolvex/models
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
LOGISTICS_MCP_URL=http://localhost:8001/mcp

{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "targets": [
        {
          "expr": "sum by (route) (rate(resolvex_http_server_requests_total[5m]))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "title": "HTTP request rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(resolvex_http_server_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "title": "HTTP P95 latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "targets": [
        {
          "expr": "sum by (trigger, outcome) (increase(resolvex_agent_runs_total[15m]))",
          "legendFormat": "{{trigger}} / {{outcome}}",
          "refId": "A"
        }
      ],
      "title": "Agent run outcomes",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, trigger) (rate(resolvex_agent_run_duration_seconds_bucket[5m])))",
          "legendFormat": "{{trigger}}",
          "refId": "A"
        }
      ],
      "title": "Agent run P95 latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "id": 5,
      "targets": [
        {
          "expr": "sum by (dependency, outcome) (rate(resolvex_external_calls_total[5m]))",
          "legendFormat": "{{dependency}} / {{outcome}}",
          "refId": "A"
        }
      ],
      "title": "External dependency calls",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "max": 2,
          "min": 0,
          "mappings": [
            {
              "options": {
                "0": {"text": "closed"},
                "1": {"text": "half-open"},
                "2": {"text": "open"}
              },
              "type": "value"
            }
          ]
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 16},
      "id": 6,
      "targets": [
        {
          "expr": "max by (dependency) (resolvex_circuit_state)",
          "legendFormat": "{{dependency}}",
          "refId": "A"
        }
      ],
      "title": "Circuit state",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 16},
      "id": 7,
      "targets": [
        {
          "expr": "sum by (dependency) (increase(resolvex_circuit_rejections_total[15m]))",
          "legendFormat": "{{dependency}}",
          "refId": "A"
        }
      ],
      "title": "Circuit fast-fail rejections",
      "type": "stat"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 42,
  "tags": ["resolvex", "p1"],
  "templating": {"list": []},
  "time": {"from": "now-15m", "to": "now"},
  "timezone": "browser",
  "title": "ResolveX Overview",
  "uid": "resolvex-overview",
  "version": 1
}
